# MongoDB Atlas Connection String
# Reemplaza <usuario>, <password> y <cluster> con tus credenciales de MongoDB Atlas
# Ejemplo: mongodb+srv://admin:miClaveSegura123@cluster0.abcde.mongodb.net/exclusive_autowash?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxx.mongodb.net/exclusive_autowash?retryWrites=true&w=majority

# Credenciales de Acceso Administrativo (Opcionales - se pueden configurar en Vercel)
# Si no se definen, el sistema usa los valores seguros por defecto:
ADMIN_USERNAME=exclusivespa_admin
ADMIN_PASSWORD=admin1234*

WORKER_USERNAME=exclusivespa_trabajador
WORKER_PASSWORD=trabajo1234*

